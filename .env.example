# Thirdweb client ID for wallet connect and Insight API
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_client_id_here

# Active attestation chain: omachain-testnet or omachain-mainnet
NEXT_PUBLIC_ACTIVE_CHAIN=omachain-testnet

# Asset prefix for serving CSS/JS from a specific origin.
# Only needed if the widget HTML is reverse-proxied through another domain.
# For the standard iframe embed (src=widgets.omatrust.org), this is unnecessary —
# the browser resolves assets relative to the iframe's own origin.
# NEXT_PUBLIC_ASSET_PREFIX=https://widgets.omatrust.org

# Relay base URL for delegated attestation API
# Default: https://api.omatrust.org (routes through the API gateway)
# For local dev, point to rep-attestation-frontend directly (e.g., http://localhost:3001)
# NEXT_PUBLIC_RELAY_BASE_URL=http://localhost:3001
